/modules/network/         @YOUR-ORG/platform-security
/modules/application/     @YOUR-ORG/platform-security
/environments/prod/        @YOUR-ORG/production-owners
/.githooks/              @YOUR-ORG/platform-security
/.agents/                 @YOUR-ORG/platform-security
/.codex/                  @YOUR-ORG/platform-security
/Makefile                 @YOUR-ORG/platform-security
